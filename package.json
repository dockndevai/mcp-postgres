{
  "name": "@dockndevai/mcp-postgres",
  "mcpName": "io.github.dockndevai/mcp-postgres",
  "version": "0.1.0",
  "description": "Model Context Protocol server for PostgreSQL — explore schemas, run read-only queries, explain plans, and make governed changes, with security modes and access-control flags.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockndevai/mcp-postgres.git"
  },
  "bugs": {
    "url": "https://github.com/dockndevai/mcp-postgres/issues"
  },
  "homepage": "https://github.com/dockndevai/mcp-postgres#readme",
  "bin": {
    "mcp-postgres": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "sql",
    "database",
    "dba",
    "llm",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
