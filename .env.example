# --- Connection -------------------------------------------------------------
# libpq connection string. Alternatively set PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE.
# Use a dedicated least-privilege role (see README → Recommended database role).
POSTGRES_URL=postgresql://mcp_readonly:CHANGE_ME@localhost:5432/app
# TLS: off | require (encrypt, no CA check) | verify (encrypt + verify the server certificate).
POSTGRES_SSL=off
POSTGRES_APP_NAME=mcp-postgres
# Per-statement timeout and connect timeout, in ms.
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
# Max rows returned to the model per call.
POSTGRES_MAX_ROWS=200
# Insert/update/delete that would touch more rows than this is rolled back.
POSTGRES_MAX_AFFECTED_ROWS=1000
# Replace values in password/secret/token/api_key-like columns with [REDACTED].
POSTGRES_REDACT_SECRET_COLUMNS=true
# Superuser connections are refused unless this is true. Recommended: false.
POSTGRES_ALLOW_SUPERUSER=false

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
POSTGRES_MODE=read-only
# Comma-separated schema allowlist. Empty = all schemas. While set, free-form SQL is refused.
POSTGRES_SCHEMA_ALLOWLIST=
# Schemas that can be read but never mutated.
POSTGRES_PROTECTED_SCHEMAS=
# Treat pg_catalog / information_schema / pg_toast / pg_* as protected. Recommended: true.
POSTGRES_PROTECT_SYSTEM_SCHEMAS=true
# delete_rows / drop_table / terminate_backend require this in addition to admin mode.
POSTGRES_ALLOW_DELETE=false
# Registers execute_sql (one arbitrary statement, human-approved) in admin mode.
POSTGRES_ALLOW_RAW_SQL=false
# Validate + log writes without changing the database.
POSTGRES_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
POSTGRES_AUDIT_LOG=true
# Refuse destructive ops when the client cannot show a human approval prompt (instead of trusting the flags alone).
POSTGRES_REQUIRE_HUMAN_APPROVAL=false

# --- AI risk guard (optional; needs a running laya-guard daemon) -------------
# High-risk ops ask a LOCAL laya-guard daemon to classify them allow / confirm / block. Runs AFTER
# the deterministic gates; only tightens, never grants; fails closed.  off | monitor | enforce
POSTGRES_GUARD_MODE=off
POSTGRES_GUARD_URL=http://127.0.0.1:8799
POSTGRES_GUARD_TIMEOUT_MS=2000
POSTGRES_GUARD_FAIL_CLOSED=confirm
